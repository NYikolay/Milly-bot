# local -> long polling, production -> webhook
ENVIRONMENT=local

BOT_TOKEN=123456789:replace-me

# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# console | json (default: console for local, json for production)
# LOG_FORMAT=json

# Required when ENVIRONMENT=production
# WEBHOOK_BASE_URL=https://bot.example.com
WEBHOOK_PATH=/webhook
# WEBHOOK_SECRET=change-me
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# FSM storage (docker compose overrides host to redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

DROP_PENDING_UPDATES=false
